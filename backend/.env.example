# llm_wiki 的唯一环境配置：复制为 backend/.env，填入服务密钥。
# Docker: docker compose -f docker-compose.app.yml --env-file backend/.env up -d --build
# 本机开发: ./start.sh（Node >=22.19）
PORT=3088
WEB_PORT=8080
HOST=127.0.0.1
DSH_CHILD_HTTP_PORT=3090
DSH_PROFILE=rag-kb
DSH_HOME_DIR=.runtime/dsh-home

# 阿里云百炼工作空间的 OpenAI 兼容地址。
LLM_PROVIDER=aliyun
LLM_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
LLM_API_KEY=your-aliyun-model-key
LLM_MAX_TOKENS=8192
# Qwen 使用 enable_thinking=false 真正关闭推理；仅隐藏思考文本不会提速。
LLM_REASONING_EFFORT=off
VLM_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.8-omni-flash
VLM_API_KEY=your-aliyun-model-key
VLM_MAX_IMAGE_BYTES=5242880

# HTTPS 服务入口。LightRAG 使用 X-API-Key，MinerU 使用 Bearer。
# 文档上传走 LightRAG，其服务端已连接 MinerU 兼容适配器，负责解析 PDF/DOCX。
LIGHTRAG_BASE_URL=https://www.agent-show.com/lightrag
LIGHTRAG_API_KEY=your-lightrag-service-key
MINERU_BASE_URL=https://www.agent-show.com/mineru
MINERU_API_KEY=your-mineru-service-key

# 远程 REST 模式留空：这两项需可读的服务端共享目录才能启用。
KB_RAG_STORAGE=
KB_LIGHTRAG_INPUTS_DIR=
# 无线工单账本/本地记忆包默认存储在 DSH_HOME/storages/dsh-wireless。
# WIRELESS_DATA_DIR=
# 历史编译使用 Python 3.12 验证；本机默认 backend/.runtime/wireless-python/bin/python，镜像已安装。
# WIRELESS_PYTHON=
