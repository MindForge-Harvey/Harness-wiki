# =====================================================================
# rag-kb 后端统一环境配置（模板）
# 使用：复制本文件为同目录 .env，填入真实值；.env 已被 .gitignore 排除。
# 加载：backend/index.js 启动时注入 process.env，并随 dsh 子进程环境透传。
# =====================================================================

# ---- 适配层 ----
PORT=3088
# speech-recognition-agent 服务根地址；本地默认 8765，容器部署填实际可达地址。
VOICE_API_BASE_URL=http://127.0.0.1:8765
# 线上使用语音服务自己的 CAS Cookie；设置同域入口路径，浏览器直连其 API。
# 本地留空使用上方本机代理；docker-compose.server.yml 已设置 /speech-recognition。
VOICE_PUBLIC_BASE_PATH=
# dsh 子进程 webserver 端口（/kb/*、/approvals/* 透传通道）
DSH_CHILD_HTTP_PORT=3090
# dsh profile 名（对应 backend/dsh/home/profiles/<名>/）
DSH_PROFILE=rag-kb
# dsh-home 相对 backend 目录的位置
DSH_HOME_DIR=dsh/home

# ---- 大模型（settings.yaml 中 provider 的 apiKeyEnv 引用下方 key）----
LLM_PROVIDER=qwen-token-plan
LLM_MODEL=glm-5.2
# 无此项模型不回传思考（reasoning）块
LLM_REASONING_EFFORT=max
QWEN_TOKEN_PLAN_API_KEY=sk-xxxxxxxx

# ---- 知识库（LightRAG 引擎）----
# 引擎 REST 地址（dsh-knowledge engine-port 读取）
LIGHTRAG_BASE_URL=http://127.0.0.1:9623
# 引擎或网关开启 API Key 鉴权时填写，未开启可留空
LIGHTRAG_API_KEY=
# 引擎活库宿主路径（对应 docker 挂载 rag-storage-0.6B -> /app/data/rag_storage）
KB_RAG_STORAGE=/absolute/path/to/rag_storage
# 原料区根目录（含 __parsed__，图文注入与 /kb/image 图片定位用）
KB_LIGHTRAG_INPUTS_DIR=/absolute/path/to/inputs

# LightRAG 引擎自身配置（compose 挂载用）：引擎 .env 文件（含引擎模型 key，缺失时 compose 启动报错）与 prompts 目录
LIGHTRAG_DOTENV=/absolute/path/to/LightRAG/.env
LIGHTRAG_PROMPTS_DIR=/absolute/path/to/LightRAG/data/prompts
